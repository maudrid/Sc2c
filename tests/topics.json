{
  "_notes": [
    "The test topics. Each test class carries [Trait(\"Topic\", NAME)] with one of these names; tools/run_tests.py runs topics as separate test runs, several at a time, and with --changed only the topics whose files changed.",
    "paths: the files a topic's tests exercise (globs from the repository root; ** is any folders, * anything in one name). A change to one of them runs the topic; a change to a test file runs its own topic. Every source file must be covered by some topic (TopicTests checks it).",
    "all: files whose change runs every topic (shared code, the test project, the data every topic reads).",
    "weight: roughly how long the topic takes, so the heaviest start first. alone: the topic has timing-sensitive tests, so it runs after the others, by itself."
  ],
  "all": [
    "src/Crateris.Core/Crateris.Core.csproj",
    "src/Crateris.Presentation/Crateris.Presentation.csproj",
    "src/Crateris.Core/Uqm/**",
    "src/Crateris.Core/Data/**",
    "data/**",
    "tests/topics.json",
    "tests/Crateris.Core.Tests/Crateris.Core.Tests.csproj",
    "tests/Crateris.Core.Tests/Golden.cs",
    "tests/Crateris.Core.Tests/ContentPackageTests.cs",
    "Directory.Build.props",
    "global.json"
  ],
  "topics": {
    "content": {
      "weight": 10,
      "alone": true,
      "paths": [
        "src/Crateris.Core/Content/**",
        "src/Crateris.Presentation/Sprites.cs",
        "src/Crateris.Presentation/UqmFont.cs",
        "src/Crateris.Presentation/OrbitScreenText.cs",
        "tests/golden/fonts.json", "tests/golden/images.json", "tests/golden/string-*.json",
        "tests/golden/resource-index-cases.json", "tests/golden/names.json", "tests/golden/binary-tables.json",
        "tests/golden/sprite-masks.json", "tests/golden/intersections.json"
      ]
    },
    "hyperspace": {
      "weight": 2,
      "paths": [
        "src/Crateris.Core/Hyperspace/**",
        "src/Crateris.Core/Session/StarEntryTracker.cs",
        "src/Crateris.Presentation/HyperScreen.cs",
        "tests/golden/hyperspace-flight.json",
        "tests/golden/uqm-math.json"
      ]
    },
    "systems": {
      "weight": 6,
      "paths": [
        "src/Crateris.Core/Systems/**",
        "src/Crateris.Core/Content/ContactShapes.cs",
        "src/Crateris.Presentation/SystemSprites.cs",
        "src/Crateris.Presentation/SmoothedMotion.cs",
        "src/Crateris.Presentation/OrbitScreenText.cs",
        "tests/golden/star-systems.json", "tests/golden/world-surfaces.json", "tests/golden/system-layout.json",
        "tests/golden/system-sprites.json", "tests/golden/ip-*.json"
      ]
    },
    "planet-maps": {
      "weight": 100,
      "paths": [
        "src/Crateris.Core/Systems/SurfaceMap.cs",
        "src/Crateris.Core/Systems/PlanetsideMap.cs",
        "src/Crateris.Core/Systems/SystemGenerator.cs",
        "src/Crateris.Core/Systems/PlanetAnalysis.cs",
        "src/Crateris.Core/Systems/Surface.cs",
        "src/Crateris.Core/Systems/WorldDesc.cs",
        "src/Crateris.Core/Systems/WorldTypes.cs",
        "src/Crateris.Core/Content/**",
        "src/Crateris.Presentation/PlanetSurfaces.cs",
        "src/Crateris.Presentation/PlanetSphere.cs",
        "tests/golden/surface-*.json", "tests/golden/planet-spheres.json", "tests/golden/planetside-*.json",
        "tests/golden/binary-tables.json"
      ]
    },
    "world": {
      "weight": 4,
      "paths": [
        "src/Crateris.Core/World/**",
        "src/Crateris.Core/Session/**",
        "src/Crateris.Core/Net/Protocol.cs",
        "src/Crateris.Core/Systems/Landing.cs",
        "src/Crateris.Core/Systems/IpFlight.cs",
        "src/Crateris.Core/Hyperspace/**",
        "tests/golden/landing.json"
      ]
    },
    "net": {
      "weight": 4,
      "alone": true,
      "paths": [
        "src/Crateris.Core/Net/**",
        "src/Crateris.Core/World/**",
        "src/Crateris.Core/Session/HostSession.cs",
        "src/Crateris.Core/Planetside/**"
      ]
    },
    "lander": {
      "weight": 12,
      "paths": [
        "src/Crateris.Core/Planetside/**",
        "src/Crateris.Core/Content/ContactShapes.cs",
        "src/Crateris.Core/World/ShipHold.cs",
        "src/Crateris.Core/Systems/PlanetsideMap.cs",
        "src/Crateris.Core/Systems/Surface.cs",
        "tests/golden/lander.json", "tests/golden/lander-pickups.json", "tests/golden/lander-creatures.json",
        "tests/golden/lander-hazards.json", "tests/golden/world-surfaces.json"
      ]
    },
    "shared-surface": {
      "weight": 4,
      "paths": [
