        "src/Crateris.Core/World/**",
        "src/Crateris.Core/Session/**",
        "src/Crateris.Core/Systems/OrbitMenu.cs",
        "src/Crateris.Core/Systems/Landing.cs"
      ]
    },
    "drawing": {
      "weight": 6,
      "paths": [
        "src/Crateris.Presentation/PlanetsideScreen.cs",
        "src/Crateris.Presentation/PlanetsideSprites.cs",
        "src/Crateris.Core/Planetside/**",
        "src/Crateris.Core/World/SurfaceSnapshot.cs",
        "src/Crateris.Core/World/ShipHold.cs",
        "src/Crateris.Core/Content/ContactShapes.cs",
        "tests/golden/lander-drawing.json"
      ]
    }
  }
}
